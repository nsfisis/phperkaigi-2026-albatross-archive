 style=\"color:#D73A49\">===</span><span style=\"color:#005CC5\"> 2</span><span style=\"color:#D73A49\"> ||</span><span style=\"color:#24292E\"> $alive </span><span style=\"color:#D73A49\">===</span><span style=\"color:#005CC5\"> 3</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">?</span><span style=\"color:#032F62\"> '#'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '.'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        } </span><span style=\"color:#D73A49\">else</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            $row </span><span style=\"color:#D73A49\">.=</span><span style=\"color:#24292E\"> ($alive </span><span style=\"color:#D73A49\">===</span><span style=\"color:#005CC5\"> 3</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">?</span><span style=\"color:#032F62\"> '#'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '.'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    $next[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> $row;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#005CC5\">echo</span><span style=\"color:#005CC5\"> implode</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">\"</span><span style=\"color:#005CC5\">\\n</span><span style=\"color:#032F62\">\"</span><span style=\"color:#24292E\">, $next) </span><span style=\"color:#D73A49\">.</span><span style=\"color:#032F62\"> \"</span><span style=\"color:#005CC5\">\\n</span><span style=\"color:#032F62\">\"</span><span style=\"color:#24292E\">;</s